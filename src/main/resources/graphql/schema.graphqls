type Query {
    legoCollection(id: String): LegoCollection
    legoCollections(page: Int): [LegoCollection]
}

type LegoCollection {
    id: String
    description: String
    numberOfSets: Int
    numberOfParts: Int
    items: [LegoCollectionItem]
}

type LegoCollectionItem {
    index: Int
    quantity: Int
    comment: String
    legoElement: LegoElement
}

type LegoElement {
    id: String
    design: String
    legoPart: LegoPart
}

type LegoPart {
    id: String
    name: String
}